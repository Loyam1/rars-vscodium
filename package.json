{
  "name": "rars-vscodium",
  "displayName": "RARS for VSCodium",
  "description": "Execute RISC-V assembly with RARS from VSCodium.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Debuggers", "Other"],
  "activationEvents": [
    "onCommand:rarsVscodium.runActiveFile",
    "onCommand:rarsVscodium.openGui",
    "onCommand:rarsVscodium.configureJar",
    "onCommand:rarsVscodium.debugActiveFile",
    "onCommand:rarsVscodium.debugStep",
    "onCommand:rarsVscodium.debugContinue",
    "onCommand:rarsVscodium.debugLaunch",
    "onCommand:rarsVscodium.debugBack",
    "onCommand:rarsVscodium.debugPause",
    "onCommand:rarsVscodium.debugStop",
    "onCommand:rarsVscodium.toggleBreakpoint"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rarsVscodium.runActiveFile",
        "title": "RARS: Executer le fichier actif"
      },
      {
        "command": "rarsVscodium.openGui",
        "title": "RARS: Ouvrir dans l'interface graphique"
      },
      {
        "command": "rarsVscodium.configureJar",
        "title": "RARS: Choisir le fichier JAR"
      },
      {
        "command": "rarsVscodium.debugActiveFile",
        "title": "RARS: Deboguer le fichier actif",
        "icon": "$(debug-alt)"
      },
      {
        "command": "rarsVscodium.debugStep",
        "title": "RARS: Pas a pas (instruction suivante)",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "rarsVscodium.debugContinue",
        "title": "RARS: Continuer l'execution",
        "icon": "$(debug-continue)"
      },
      {
        "command": "rarsVscodium.debugLaunch",
        "title": "RARS: Lancer depuis le debut",
        "icon": "$(play)"
      },
      {
        "command": "rarsVscodium.debugBack",
        "title": "RARS: Pas a pas arriere",
        "icon": "$(arrow-left)"
      },
      {
        "command": "rarsVscodium.debugPause",
        "title": "RARS: Pause",
        "icon": "$(debug-pause)"
      },
      {
        "command": "rarsVscodium.debugStop",
        "title": "RARS: Arreter la session de debogage",
        "icon": "$(debug-stop)"
      },
      {
        "command": "rarsVscodium.toggleBreakpoint",
        "title": "RARS: Basculer un point d'arret sur cette ligne",
        "icon": "$(circle-filled)"
      }
    ],
    "keybindings": [
      {
        "command": "rarsVscodium.debugContinue",
        "key": "f5",
        "when": "rarsVscodium.sessionActive"
      },
      {
        "command": "rarsVscodium.debugActiveFile",
        "key": "f5",
        "when": "!rarsVscodium.sessionActive && resourceExtname == .asm"
      },
      {
        "command": "rarsVscodium.debugStep",
        "key": "f10",
        "when": "rarsVscodium.sessionActive"
      },
      {
        "command": "rarsVscodium.debugStop",
        "key": "shift+f5",
        "when": "rarsVscodium.sessionActive"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "rarsVscodium.toggleBreakpoint",
          "when": "resourceExtname == .asm"
        }
      ]
    },
    "configuration": {
      "title": "RARS for VSCodium",
      "properties": {
        "rarsVscodium.jarPath": {
          "type": "string",
          "default": "",
          "description": "Chemin absolu ou relatif au workspace vers rars.jar."
        },
        "rarsVscodium.javaPath": {
          "type": "string",
          "default": "java",
          "description": "Executable Java (11 minimum) utilise pour lancer le pont de debogage."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
